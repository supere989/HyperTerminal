#!/usr/bin/env bash
set -euo pipefail

readonly SOCKET_NAME="${HYPERTERMINAL_TMUX_SOCKET:-hyperterminal}"
readonly TMUX_CONFIG="${HYPERTERMINAL_TMUX_CONFIG:-$HOME/.config/hyperterminal/tmux.conf}"
readonly RUNNER="$HOME/.local/bin/hyperterminal-agent-runner"
readonly SELF="$HOME/.local/bin/hyperterminal-session"
readonly STATE_ROOT="${HYPERTERMINAL_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/hyperterminal}"
readonly SESSION_STATE_DIR="$STATE_ROOT/sessions"
readonly SHUTDOWN_MARKER="$STATE_ROOT/restore-on-login"
readonly TAB_QUEUE="$STATE_ROOT/tab-restore.queue"
readonly TAB_QUEUE_LOCK="$STATE_ROOT/tab-restore.lock"
readonly -a TMUX=(/usr/bin/tmux -L "$SOCKET_NAME" -f "$TMUX_CONFIG")

valid_agent() {
    "$HOME/.local/bin/hyperterminal-catalog" known "$1"
}

agent_available() {
    [[ "$1" == shell ]] || "$HOME/.local/bin/hyperterminal-catalog" resolve "$1" >/dev/null
}

valid_conversation() {
    [[ -z "$1" || "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$ ]]
}

valid_session_name() {
    [[ "$1" =~ ^[a-zA-Z0-9_.-]+$ ]]
}

session_exists() {
    valid_session_name "$1" && "${TMUX[@]}" has-session -t "=$1" 2>/dev/null
}

ensure_state_dir() {
    mkdir -p "$SESSION_STATE_DIR"
    chmod 700 "$STATE_ROOT" "$SESSION_STATE_DIR"
}

write_state() {
    local name="${1:?session required}"
    local agent="${2:?agent required}"
    local working_dir="${3:?working directory required}"
    local encoded_dir temp_file line conversation="${4:-}"
    # Preserve the identity of explicitly resumed conversations during snapshots.
    if [[ $# -lt 4 && -f "$SESSION_STATE_DIR/$name.session" ]]; then
        while IFS= read -r line; do
            [[ "$line" == conversation_id=* ]] && conversation="${line#*=}"
        done <"$SESSION_STATE_DIR/$name.session"
    fi
    valid_conversation "$conversation" || return 64
    valid_session_name "$name" && valid_agent "$agent" || return 64
    ensure_state_dir
    encoded_dir="$(printf '%s' "$working_dir" | base64 -w0)"
    temp_file="$(mktemp "$SESSION_STATE_DIR/.${name}.XXXXXX")"
    chmod 600 "$temp_file"
    printf 'version=2\nagent=%s\ndirectory_b64=%s\nconversation_id=%s\n' \
        "$agent" "$encoded_dir" "$conversation" >"$temp_file"
    mv -f -- "$temp_file" "$SESSION_STATE_DIR/$name.session"
}

read_state() {
    local file="${1:?state file required}"
    local line key value agent="" encoded_dir="" working_dir conversation=""
    while IFS= read -r line; do
        key="${line%%=*}"
        value="${line#*=}"
        case "$key" in
            agent) agent="$value" ;;
            directory_b64) encoded_dir="$value" ;;
            conversation_id) conversation="$value" ;;
        esac
    done <"$file"
    valid_agent "$agent" && valid_conversation "$conversation" || return 1
    working_dir="$(printf '%s' "$encoded_dir" | base64 -d 2>/dev/null)" || return 1
    if [[ -z "$conversation" && ! -d "$working_dir" ]]; then working_dir="$HOME"; fi
    printf '%s\t%s\t%s\n' "$agent" "$working_dir" "${conversation:--}"
}

write_tab_queue() {
    local temp_file name
    ensure_state_dir
    temp_file="$(mktemp "$STATE_ROOT/.tab-restore.XXXXXX")"
    chmod 600 "$temp_file"
    for name in "$@"; do
        valid_session_name "$name" || continue
        printf '%s\n' "$name" >>"$temp_file"
    done
    if [[ -s "$temp_file" ]]; then
        mv -f -- "$temp_file" "$TAB_QUEUE"
    else
        unlink "$temp_file"
        [[ -e "$TAB_QUEUE" ]] && unlink "$TAB_QUEUE"
    fi
    return 0
}

queue_detached_tabs() {
    local name attached agent windows current
    local -a names=()
    while IFS=$'\t' read -r name attached agent windows current; do
        [[ -n "$name" && "${attached:-0}" -eq 0 ]] || continue
        names+=("$name")
    done < <(list_sessions)
    write_tab_queue "${names[@]}"
    printf 'queued=%s\n' "${#names[@]}"
}

claim_tab() {
    local name temp_file
    ensure_state_dir
    exec 9>"$TAB_QUEUE_LOCK"
    flock 9
    [[ -s "$TAB_QUEUE" ]] || return 1
    IFS= read -r name <"$TAB_QUEUE"
    valid_session_name "$name" || return 1
    temp_file="$(mktemp "$STATE_ROOT/.tab-restore.XXXXXX")"
    chmod 600 "$temp_file"
    sed '1d' "$TAB_QUEUE" >"$temp_file"
    if [[ -s "$temp_file" ]]; then
        mv -f -- "$temp_file" "$TAB_QUEUE"
    else
        unlink "$temp_file"
        unlink "$TAB_QUEUE"
    fi
    printf '%s\n' "$name"
}

tab_queue_count() {
    if [[ -f "$TAB_QUEUE" ]]; then
        wc -l <"$TAB_QUEUE"
    else
        printf '0\n'
    fi
}

unique_name() {
    local agent="$1"
    local base candidate suffix=1
    base="${agent}-$(date +%m%d-%H%M)"
    candidate="$base"
    while session_exists "$candidate" || [[ -e "$SESSION_STATE_DIR/$candidate.session" ]]; do
        suffix=$((suffix + 1))
        candidate="${base}-${suffix}"
    done
    printf '%s\n' "$candidate"
}

create_named_session() {
    local name="${1:?session required}"
    local agent="${2:?agent required}"
    local working_dir="${3:-$PWD}"
    local restore="${4:-0}"
    local conversation="${5:-}"
    local command
    valid_session_name "$name" || return 64
    valid_agent "$agent" || {
        printf 'Unsupported managed agent: %s\n' "$agent" >&2
        return 64
    }
    agent_available "$agent" || { printf 'Agent unavailable: %s; saved session retained.\n' "$agent" >&2; return 1; }
    valid_conversation "$conversation" || return 64
    if [[ -n "$conversation" && ! -d "$working_dir" ]]; then
        printf 'Saved project directory unavailable: %s; session retained.\n' "$working_dir" >&2
        return 1
    fi
    [[ -d "$working_dir" ]] || working_dir="$HOME"
    if [[ -n "$conversation" ]]; then
        printf -v command '%q --mode id %q %q' "$RUNNER" "$agent" "$conversation"
    elif [[ "$restore" == latest || "$restore" == picker ]]; then
        printf -v command '%q --mode %q %q' "$RUNNER" "$restore" "$agent"
    elif [[ "$restore" == 1 ]]; then
        printf -v command '%q --restore %q' "$RUNNER" "$agent"
    else
        printf -v command '%q %q' "$RUNNER" "$agent"
    fi
    "${TMUX[@]}" new-session -d -s "$name" -c "$working_dir" "$command" || return
    "${TMUX[@]}" set-option -q -t "$name" @hyperterminal_agent "$agent"
    "${TMUX[@]}" set-option -q -t "$name" @hyperterminal_created "$(date --iso-8601=seconds)"
    "${TMUX[@]}" source-file "$TMUX_CONFIG"
    write_state "$name" "$agent" "$working_dir" "$conversation"
}

create_session() {
    local agent="${1:?agent required}"
    local working_dir="${2:-$PWD}"
    local mode="${3:-new}" conversation="${4:-}" name
    case "$mode" in new|latest|picker|id) ;; *) return 64 ;; esac
    [[ "$mode" != id || -n "$conversation" ]] || return 64
    if [[ "$mode" == picker ]]; then
        "$HOME/.local/bin/hyperterminal-catalog" command "$agent" --mode picker >/dev/null || return 1
    fi
    name="$(unique_name "$agent")"
    create_named_session "$name" "$agent" "$working_dir" "$mode" "$conversation" || return
    printf '%s\n' "$name"
}

forget_session() {
    local name="${1:?session required}"
    valid_session_name "$name" || return 64
    [[ -e "$SHUTDOWN_MARKER" ]] && return 0
    [[ -e "$SESSION_STATE_DIR/$name.session" ]] || return 0
    unlink "$SESSION_STATE_DIR/$name.session"
}

snapshot_sessions() {
    local name attached agent windows current working_dir
    ensure_state_dir
    while IFS=$'\t' read -r name attached agent windows current; do
        [[ -n "$name" ]] || continue
        valid_agent "$agent" || continue
        working_dir="$("${TMUX[@]}" display-message -p -t "$name" '#{pane_current_path}' 2>/dev/null || true)"
        [[ -d "$working_dir" ]] || working_dir="$HOME"
        write_state "$name" "$agent" "$working_dir"
    done < <(list_sessions)
}

prepare_shutdown() {
    ensure_state_dir
    : >"$SHUTDOWN_MARKER"
    chmod 600 "$SHUTDOWN_MARKER"
    snapshot_sessions
}

restore_sessions() {
    local file name agent working_dir conversation restored=0
    local -a state_files=()
    local -a restored_names=()
    ensure_state_dir
    shopt -s nullglob
    state_files=("$SESSION_STATE_DIR"/*.session)
    shopt -u nullglob
    for file in "${state_files[@]}"; do
        name="${file##*/}"
        name="${name%.session}"
        valid_session_name "$name" || continue
        session_exists "$name" && continue
        if IFS=$'\t' read -r agent working_dir conversation < <(read_state "$file"); then
            [[ "$conversation" == - ]] && conversation=""
            if create_named_session "$name" "$agent" "$working_dir" 1 "$conversation"; then
                restored=$((restored + 1))
                restored_names+=("$name")
            fi
        fi
    done
    if (( restored > 0 )); then
        local queued
        local -a pending=()
        if [[ -f "$TAB_QUEUE" ]]; then
            while IFS= read -r queued; do
                valid_session_name "$queued" && session_exists "$queued" && pending+=("$queued")
            done <"$TAB_QUEUE"
        fi
        for name in "${restored_names[@]}"; do
            [[ " ${pending[*]} " == *" $name "* ]] || pending+=("$name")
        done
        write_tab_queue "${pending[@]}"
    fi
    [[ -e "$SHUTDOWN_MARKER" ]] && unlink "$SHUTDOWN_MARKER"
    printf 'restored=%s\n' "$restored"
}

attach_session() {
    local name="${1:?session required}"
    session_exists "$name" || {
        printf 'Managed session no longer exists: %s\n' "$name" >&2
        return 1
    }
    "${TMUX[@]}" source-file "$TMUX_CONFIG"
    exec "${TMUX[@]}" attach-session -d -t "$name"
}

popout_session() {
    local name="${1:-}"
    local working_dir
    if [[ -z "$name" && -n "${TMUX_PANE:-}" ]]; then
        name="$("${TMUX[@]}" display-message -p '#S')"
    fi
    session_exists "$name" || {
        printf 'Managed session no longer exists: %s\n' "$name" >&2
        return 1
    }
    working_dir="$("${TMUX[@]}" display-message -p -t "$name" '#{pane_current_path}')"
    [[ -d "$working_dir" ]] || working_dir="$HOME"
    /usr/bin/konsole --separate --profile HyperTerminal --workdir "$working_dir" \
        --hide-menubar -e "$SELF" external-attach "$name" >/dev/null 2>&1 &
}

focus_external() {
    local service="${1:?service required}"
    local window_id="${2:?window required}"
    local session_id="${3:?session required}"
    local visible
    [[ "$service" =~ ^org\.kde\.konsole-[0-9]+$ ]] || return 64
    [[ "$window_id" =~ ^[0-9]+$ && "$session_id" =~ ^[0-9]+$ ]] || return 64

    qdbus6 "$service" "/Windows/$window_id" org.kde.konsole.Window.setCurrentSession "$session_id" >/dev/null
    qdbus6 "$service" "/konsole/MainWindow_$window_id" org.qtproject.Qt.QWidget.show >/dev/null 2>&1 || true
    qdbus6 "$service" "/konsole/MainWindow_$window_id" org.qtproject.Qt.QWidget.raise >/dev/null 2>&1 || true
    qdbus6 "$service" "/konsole/MainWindow_$window_id" org.qtproject.Qt.QWidget.setFocus >/dev/null 2>&1 || true

    visible="$(qdbus6 org.kde.yakuake /yakuake/MainWindow_1 org.freedesktop.DBus.Properties.Get org.qtproject.Qt.QWidget visible 2>/dev/null || true)"
    if [[ "$visible" == true ]]; then
        qdbus6 org.kde.yakuake /yakuake/window org.kde.yakuake.toggleWindowState >/dev/null 2>&1 || true
    fi
}

list_sessions() {
    local name attached agent windows current
    while IFS=$'\t' read -r name attached agent windows; do
        [[ -n "$name" ]] || continue
        current="$("${TMUX[@]}" display-message -p -t "$name" '#{pane_current_command}' 2>/dev/null || printf unknown)"
        printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$attached" "$agent" "$windows" "$current"
    done < <("${TMUX[@]}" list-sessions \
        -F $'#{session_name}\t#{session_attached}\t#{@hyperterminal_agent}\t#{session_windows}' \
        2>/dev/null || true)
}

list_saved_sessions() {
    local file name agent directory conversation
    shopt -s nullglob
    for file in "$SESSION_STATE_DIR"/*.session; do
        name="${file##*/}"; name="${name%.session}"
        valid_session_name "$name" || continue
        session_exists "$name" && continue
        if IFS=$'\t' read -r agent directory conversation < <(read_state "$file"); then
            printf '%s\t%s\t%s\t%s\n' "$name" "$agent" "$directory" "$conversation"
        fi
    done
}

resume_saved_session() {
    local name="${1:?session required}" agent directory conversation
    valid_session_name "$name" || return 64
    if ! session_exists "$name"; then
        [[ -f "$SESSION_STATE_DIR/$name.session" ]] || return 1
        IFS=$'\t' read -r agent directory conversation < <(read_state "$SESSION_STATE_DIR/$name.session") || return 1
        [[ "$conversation" == - ]] && conversation=""
        create_named_session "$name" "$agent" "$directory" 1 "$conversation" || return
    fi
    printf '%s\n' "$name"
}

resume_conversation() {
    local agent="${1:?agent required}" conversation="${2:?ID required}" directory="${3:-$PWD}"
    local file name saved_agent saved_directory saved_id
    valid_agent "$agent" && valid_conversation "$conversation" || return 64
    # Reattach an already managed conversation instead of duplicating its process.
    shopt -s nullglob
    for file in "$SESSION_STATE_DIR"/*.session; do
        if IFS=$'\t' read -r saved_agent saved_directory saved_id < <(read_state "$file"); then
            if [[ "$saved_agent" == "$agent" && "$saved_id" == "$conversation" ]]; then
                name="${file##*/}"; name="${name%.session}"
                resume_saved_session "$name"
                return
            fi
        fi
    done
    create_session "$agent" "$directory" id "$conversation"
}

case "${1:-}" in
    create)
        create_session "${2:-}" "${3:-$PWD}" "${4:-new}" "${5:-}"
        ;;
    list-saved)
        list_saved_sessions
        ;;
    resume-saved)
        resume_saved_session "${2:-}"
        ;;
    resume-conversation)
        resume_conversation "${2:-}" "${3:-}" "${4:-$PWD}"
        ;;
    new)
        name="$(create_session "${2:-}" "${3:-$PWD}")"
        attach_session "$name"
        ;;
    attach|external-attach)
        attach_session "${2:-}"
        ;;
    popout)
        popout_session "${2:-}"
        ;;
    focus-external)
        focus_external "${2:-}" "${3:-}" "${4:-}"
        ;;
    forget)
        forget_session "${2:-}"
        ;;
    snapshot)
        snapshot_sessions
        ;;
    prepare-shutdown)
        prepare_shutdown
        ;;
    restore)
        restore_sessions
        ;;
    queue-detached-tabs)
        queue_detached_tabs
        ;;
    claim-tab)
        claim_tab
        ;;
    queue-count)
        tab_queue_count
        ;;
    list)
        list_sessions
        ;;
    *)
        printf 'usage: %s {create|list-saved|resume-saved|resume-conversation|new|attach|popout|focus-external|forget|snapshot|prepare-shutdown|restore|queue-detached-tabs|claim-tab|queue-count|list} ...\n' "${0##*/}" >&2
        exit 64
        ;;
esac
