#!/usr/bin/env bash
set -euo pipefail
# Use the same managed selector and persistence as HyperTerminal tabs.
if [[ "$#" -gt 0 ]]; then
    name="$("$HOME/.local/bin/hyperterminal-session" create "$1" "$PWD")"
    exec "$HOME/.local/bin/hyperterminal-session" attach "$name"
fi
exec "$HOME/.local/bin/hyperterminal-tab"
