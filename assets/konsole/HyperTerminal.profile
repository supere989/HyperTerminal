[Appearance]
ColorScheme=HyperTerminal
Font=FiraCode Nerd Font Mono,13,-1,5,50,0,0,0,0,0
LineSpacing=1
UseFontLineCharacters=true

[Cursor Options]
CursorShape=2
CustomCursorColor=222,145,55
UseCustomCursorColor=true

[General]
Command=/usr/bin/bash @BIN_DIR@/hyperterminal-tab
Name=HyperTerminal
Parent=FALLBACK/
StartInCurrentSessionDir=true
TerminalColumns=132
TerminalRows=36

[Interaction Options]
AutoCopySelectedText=true
CopyTextAsHTML=false
TrimLeadingSpacesInSelectedText=true
TrimTrailingSpacesInSelectedText=true
UnderlineFilesEnabled=true

[Keyboard]
KeyBindings=HyperTerminal

[Scrolling]
HistoryMode=2
ScrollBarPosition=2

[Terminal Features]
BlinkingCursorEnabled=true
