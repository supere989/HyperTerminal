#!/usr/bin/env bash
set -uo pipefail
mode=new
if [[ "${1:-}" == --restore ]]; then mode=latest; shift; fi
if [[ "${1:-}" == --mode ]]; then mode="${2:?mode required}"; shift 2; fi
agent="${1:-shell}"
shift || true
conversation=""
if [[ "$mode" == id ]]; then conversation="${1:?conversation ID required}"; shift; fi
if [[ "$agent" == shell ]]; then
    printf '\033]2;HyperTerminal: shell\007'
    exec /usr/bin/fish -l
fi
catalog="$HOME/.local/bin/hyperterminal-catalog"
argv_file="$(mktemp)" || exit 1
if ! "$catalog" command "$agent" --mode "$mode" --id "$conversation" >"$argv_file"; then
    rm -f "$argv_file"
    printf 'HyperTerminal: unable to launch %s; session record retained.\n' "$agent" >&2
    exec /usr/bin/fish -l
fi
mapfile -d '' -t command <"$argv_file"
rm -f "$argv_file"
printf '\033]2;HyperTerminal: %s (power)\007' "$agent"
"${command[@]}" "$@"
exit_code=$?
printf '\n[%s exited with status %s — continuing in fish]\n\n' "$agent" "$exit_code"
exec /usr/bin/fish -l
