#!/usr/bin/env bash
set -euo pipefail

readonly SESSION_TOOL="$HOME/.local/bin/hyperterminal-session"
readonly SOCKET_NAME="${HYPERTERMINAL_TMUX_SOCKET:-hyperterminal}"
readonly TMUX_CONFIG="$HOME/.config/hyperterminal/tmux.conf"
readonly -a TMUX=(/usr/bin/tmux -L "$SOCKET_NAME" -f "$TMUX_CONFIG")

clean_label() {
    tr '\t\r\n' '   ' | sed -E 's/[[:cntrl:]]//g; s/[[:space:]]+/ /g; s/^ //; s/ $//'
}

classify_process_tree() {
    local root_pid="$1"
    ps -eo pid=,ppid=,comm= | awk -v root="$root_pid" '
        { pid[NR]=$1; parent[$1]=$2; command[$1]=$3 }
        END {
            marked[root]=1
            for (pass=0; pass<12; pass++) {
                for (i=1; i<=NR; i++) if (marked[parent[pid[i]]]) marked[pid[i]]=1
            }
            priority[1]="codex"; priority[2]="claude"; priority[3]="grok";
            priority[4]="kimi"; priority[5]="agy"
            for (p=1; p<=5; p++) {
                for (i=1; i<=NR; i++) {
                    if (marked[pid[i]] && tolower(command[pid[i]]) ~ ("^" priority[p])) {
                        print priority[p]; exit
                    }
                }
            }
            print command[root]
        }'
}

emit_new_rows() {
    printf '%s\t%s\n' \
        'new|codex'  '＋  Codex       POWER · movable · reboot-restored' \
        'new|claude' '＋  Claude      POWER · movable · reboot-restored' \
        'new|grok'   '＋  Grok        POWER · movable · reboot-restored' \
        'new|kimi'   '＋  Kimi        POWER · movable · reboot-restored' \
        'new|agy'    '＋  Agy         POWER · movable · reboot-restored' \
        'new|shell'  '＋  Fish shell  new movable terminal session'
}

emit_managed_rows() {
    local name attached agent windows current state
    while IFS=$'\t' read -r name attached agent windows current; do
        [[ -n "$name" ]] || continue
        [[ -n "$agent" ]] || agent="session"
        if [[ "${attached:-0}" -gt 0 ]]; then
            state="attached — selecting moves it here"
        else
            state="detached — ready"
        fi
        printf 'managed|%s\t↔  %-18s %-7s %s; %s window(s); running %s\n' \
            "$name" "$name" "$agent" "$state" "${windows:-1}" "${current:-unknown}"
    done < <("$SESSION_TOOL" list)
}

emit_external_rows() {
    local service window_path window_id session_id session_path foreground agent title direct_command direct_args
    while read -r service; do
        [[ -n "$service" ]] || continue
        while read -r window_path; do
            window_id="${window_path##*/}"
            while read -r session_id; do
                [[ "$session_id" =~ ^[0-9]+$ ]] || continue
                session_path="/Sessions/$session_id"
                foreground="$(qdbus6 "$service" "$session_path" org.kde.konsole.Session.foregroundProcessId 2>/dev/null || true)"
                [[ "$foreground" =~ ^[0-9]+$ ]] || continue
                direct_command="$(ps -p "$foreground" -o comm= 2>/dev/null | sed 's/^[[:space:]]*//')"
                direct_args="$(ps -p "$foreground" -o args= 2>/dev/null || true)"
                if [[ "$direct_command" == tmux* && "$direct_args" == *"-L $SOCKET_NAME"* ]]; then
                    continue
                fi
                agent="$(classify_process_tree "$foreground" | clean_label)"
                [[ -n "$agent" ]] || agent="terminal"
                title="$(qdbus6 "$service" "$session_path" org.kde.konsole.Session.title 1 2>/dev/null | clean_label)"
                [[ -n "$title" ]] || title="Konsole session $session_id"
                printf 'external|%s|%s|%s\t↗  %-8s %-28s external / focus only\n' \
                    "$service" "$window_id" "$session_id" "$agent" "$title"
            done < <(qdbus6 "$service" "$window_path" org.kde.konsole.Window.sessionList 2>/dev/null || true)
        done < <(qdbus6 "$service" 2>/dev/null | rg '^/Windows/[0-9]+$' || true)
    done < <(qdbus6 | awk '$1 ~ /^org\.kde\.konsole-[0-9]+$/ {print $1}')
}

emit_rows() {
    emit_new_rows
    emit_managed_rows
    emit_external_rows
    printf '%s\t%s\n' 'local-shell' '•  Unmanaged fish shell in this tab'
}

perform_choice() {
    local choice="$1"
    local kind value service window_id session_id name
    IFS='|' read -r kind value service window_id session_id <<<"$choice"
    case "$kind" in
        new)
            name="$("$SESSION_TOOL" create "$value" "$PWD")"
            "$SESSION_TOOL" attach "$name" || true
            ;;
        managed)
            "$SESSION_TOOL" attach "$value" || true
            ;;
        external)
            "$SESSION_TOOL" focus-external "$value" "$service" "$window_id"
            ;;
        local-shell)
            exec /usr/bin/fish -l
            ;;
        *)
            return 64
            ;;
    esac
}

case "${1:-}" in
    --list)
        emit_rows
        exit 0
        ;;
    --choose)
        perform_choice "${2:-}"
        exit 0
        ;;
esac

queued_session="$("$SESSION_TOOL" claim-tab 2>/dev/null || true)"
if [[ -n "$queued_session" ]]; then
    "$SESSION_TOOL" attach "$queued_session" || true
fi

while true; do
    selection="$(emit_rows | fzf \
        --delimiter=$'\t' --with-nth=2 --nth=2 \
        --height=100% --layout=reverse --border=none \
        --prompt='HyperTerminal > ' \
        --header='ENTER: open or move  •  ESC: local shell  •  managed session: Ctrl-b o pops out')" || {
            exec /usr/bin/fish -l
        }
    perform_choice "${selection%%$'\t'*}"
done
